    {"type":"timeseries","title":"OAuth outcomes","gridPos":{"h":8,"w":8,"x":0,"y":32},"targets":[{"expr":"sum by (outcome) (rate(agent_oauth_outcomes_total[15m]))","legendFormat":"{{outcome}}"}]},
