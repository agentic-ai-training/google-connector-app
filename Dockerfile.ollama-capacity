# CPU-only CAPACITY CANDIDATE. Does not replace docker-compose's existing service.
# Public release/model bytes are verified before selection; no install script.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS public-artifacts
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-zstandard \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/prepare_ollama_cpu.py /prepare_ollama_cpu.py
RUN python3 -I /prepare_ollama_cpu.py

FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 libopenblas0 libvulkan1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=public-artifacts /cpu/bin/ollama /usr/bin/ollama
COPY --from=public-artifacts /cpu/lib/ollama /usr/lib/ollama
COPY --from=public-artifacts /model /opt/ollama/models
RUN test -x /usr/bin/ollama && test -x /usr/lib/ollama/llama-server \
    && ldd /usr/bin/ollama > /tmp/ollama-ldd && ! grep 'not found' /tmp/ollama-ldd \
    && ldd /usr/lib/ollama/llama-server > /tmp/runner-ldd && ! grep 'not found' /tmp/runner-ldd \
    && rm /tmp/ollama-ldd /tmp/runner-ldd
ENV OLLAMA_HOST=0.0.0.0:11434 OLLAMA_MODELS=/opt/ollama/models OLLAMA_NO_CLOUD=true \
    OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_KEEP_ALIVE=5m
EXPOSE 11434
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
